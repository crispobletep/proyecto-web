# Producción: correo cPanel que enviará y recibirá las cotizaciones.
# El puerto 2080 corresponde a CalDAV/CardDAV y no se utiliza para correo SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.phinstalaciones.cl
EMAIL_PORT=465
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_HOST_USER=phcotizacion@phinstalaciones.cl
EMAIL_HOST_PASSWORD=COLOCAR_LA_CONTRASENA_EN_EL_SERVIDOR
DEFAULT_FROM_EMAIL=phcotizacion@phinstalaciones.cl

# Puede contener más de un destinatario, separado por comas.
COTIZACIONES_EMAIL=phcotizacion@phinstalaciones.cl,administracion@phinstalaciones.cl
