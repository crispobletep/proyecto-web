# Producción: servicio SMTP que enviará las notificaciones del formulario.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=cuenta-que-envia@dominio.cl
EMAIL_HOST_PASSWORD=contrasena-de-aplicacion-del-proveedor
DEFAULT_FROM_EMAIL=cuenta-que-envia@dominio.cl

# Puede contener más de un destinatario, separado por comas.
COTIZACIONES_EMAIL=administracion@phinstalaciones.cl
